# ------------------------------------------------------------
# Nginx 設定テンプレート: Laravel JSON API の前段
# - UI は Next.js(別 ECS サービス)が描画するため、本 Nginx は JSON API のみを返す
# - Next.js のサーバーが Service Connect 経由で 8080 だけを呼ぶ。ブラウザからは届かない
# - 8080 には SG で Next.js タスクからしか届かない。X-User-IP は内部のネットワークの接続元からだけ信頼する(docs/adr/0017)
# - ECS のコンテナヘルスチェックが叩く /health は静的に 200 を返す(DBに依存させない)
#
# テンプレート機構: nginx 公式イメージの entrypoint が起動時に
# /etc/nginx/templates/*.template を envsubst して /etc/nginx/conf.d/ に出力する。
# 置換されるのは「環境変数として定義済みの名前」だけなので、$uri 等の nginx 変数は
# そのまま残る。
# ------------------------------------------------------------

upstream php_fpm {
    # php-fpm の宛先は PHP_FPM_HOST で切り替える:
    #   - compose      : "app"(サービス名で DNS 解決。Dockerfile の ENV が既定値)
    #   - ECS Fargate  : "127.0.0.1"
    server ${PHP_FPM_HOST}:9000;
    keepalive 16;
}

# Next.js(proxy.ts)は利用者の IP を X-User-IP に入れて呼ぶ。ISR の生成など特定のユーザーに
# 紐づかない呼び出しにはこのヘッダーがないため、接続元(Next.js 側)を使う。
# X-User-IP を信じるのは、Next.js がいる内部のネットワーク(プライベートアドレスとループバック)からの接続だけにする。
# 外から 8080 に直接届いた接続のヘッダーは、利用者が自由に書けるので無視する(docs/adr/0017)
geo $remote_addr $from_internal_network {
    default        0;
    127.0.0.0/8    1;
    10.0.0.0/8     1;
    172.16.0.0/12  1;
    192.168.0.0/16 1;
    ::1/128        1;
    fc00::/7       1;
}

map "$from_internal_network:$http_x_user_ip" $client_ip {
    "~^1:(?<forwarded_ip>[0-9A-Fa-f.:]+)$" $forwarded_ip;
    default                                 $remote_addr;
}

server {
    listen 8080 default_server;
    server_name _;

    include /etc/nginx/snippets/laravel.conf;
}
